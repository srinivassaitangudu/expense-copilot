# ---------------------------------------------------------------- Teller
# sandbox | development | production
# sandbox needs NO client certificate, so you can test the whole pipeline
# against fake bank data before signing anything.
TELLER_ENV=sandbox

# From the Teller dashboard (https://teller.io). Looks like app_xxxxxxxx.
TELLER_APPLICATION_ID=

# Written automatically by `npm run enroll`. Do not fill this in by hand.
TELLER_ACCESS_TOKEN=

# Required for development and production only. Download both from the Teller
# dashboard, store them outside any git repo, and never commit them.
TELLER_CERT_PATH=
TELLER_KEY_PATH=

# ------------------------------------------------------------- Splitwise
# From https://secure.splitwise.com/apps -> register an app -> copy API key.
SPLITWISE_API_KEY=

# Safety switch. While true, sync_apply simulates and writes nothing to
# Splitwise. Flip to false only once a preview looks right.
SPLITWISE_DRY_RUN=true

# Splitwise's FREE tier caps expense creation at 4 per day. sync_apply files at
# most this many real expenses per calendar day and defers the rest, so a
# backfill trickles instead of burning the cap on calls that cannot succeed.
# Set to 0 if you pay for Splitwise Pro (no daily limit).
# Note: spending_report and find_recurring read the local ledger, so your
# analysis is never limited by this.
SPLITWISE_DAILY_LIMIT=4

# ----------------------------------------------------------------- local
# Where ledger.json lives, relative to the project root.
DATA_DIR=data

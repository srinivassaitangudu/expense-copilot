# Optional local database. Hosted deployment uses Supabase Postgres with TLS.
DATABASE_URL=sqlite:///./dev.db
LOCAL_USER_ID=dev-user

# Hosted MCP only: configure an external OAuth issuer with hosted login/consent.
MCP_BASE_URL=https://your-service.onrender.com
OAUTH_ISSUER=https://your-issuer.example/
OAUTH_JWKS_URL=https://your-issuer.example/.well-known/jwks.json
OAUTH_ALLOWED_SUBJECTS=[]

# Replace with a strong random secret before storing any provider credentials.
ENCRYPTION_KEY=

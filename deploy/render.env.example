# Examples only. Set actual values in Render's private environment settings.
# Use Supabase's session pooler host/port from Connect; URL-encode the password.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=/etc/secrets/supabase-ca.crt
MCP_BASE_URL=https://YOUR_SERVICE.onrender.com
OAUTH_ISSUER=https://YOUR_TENANT.auth0.com/
OAUTH_JWKS_URL=https://YOUR_TENANT.auth0.com/.well-known/jwks.json
OAUTH_ALLOWED_SUBJECTS=["YOUR_OAUTH_SUBJECT"]
# Render generates ENCRYPTION_KEY. Keep its value private and stable for connections.
